#!/bin/sh
# Full CabinetKit update procedure (README "Update"), in the order the steps
# depend on each other. Stops at the first failing step so a broken update is
# not hidden by the steps after it.
#
# Same procedure as updcab.bat, for a Linux/macOS host over ssh:
#     cd /var/www/example.com && ./updcab
#
#     ./updcab --no-build   assets are built elsewhere (CI, another machine)
#     ./updcab --ssr        the site renders on the server: npm run buildssr
#     PHP_BIN=/usr/bin/php8.3 ./updcab   overrides the PHP picked automatically
#     COMPOSER_BIN=/path/to/composer ./updcab
set -u

cd "$(dirname "$0")" || exit 1

php_bin="${PHP_BIN:-php}"
skip_build=0
build_script="build"

for arg in "$@"; do
	case "$arg" in
		--no-build)
			skip_build=1
			;;
		# A plain build leaves the server-rendering process on the old bundle, and
		# the markup it sends stops matching the client assets. The host's own
		# script rebuilds both bundles and restarts that process — only the host
		# knows how its process is named and supervised.
		--ssr)
			build_script="buildssr"
			;;
		-h|--help)
			echo "usage: ./updcab [--no-build] [--ssr]"
			exit 0
			;;
		*)
			echo "unknown option: $arg" >&2
			exit 1
			;;
	esac
done

if [ "$skip_build" -eq 1 ] && [ "$build_script" = "buildssr" ]; then
	echo "--no-build and --ssr contradict each other: --ssr is a way to build." >&2
	exit 1
fi

# The site runs on the PHP its control panel selected, but the shell of the same
# account often still starts a years-old default — and then the very first step
# resolves dependencies for the wrong version and buries the cause in a wall of
# conflicts. So the interpreter is settled before anything runs.
php_min_id=80200

php_version_id() {
	"$1" -r 'echo PHP_VERSION_ID;' 2>/dev/null
}

php_version() {
	"$1" -r 'echo PHP_VERSION;' 2>/dev/null
}

# The version the site itself is served with, when the panel records it in the
# handler line of .htaccess — CloudLinux and cPanel both do (`alt-php83`,
# `ea-php83`, `lsphp83`). It is worth digging for: dependencies resolved on a
# CLI newer than the site's install code the site cannot run, and the failure
# surfaces as a white page rather than as an error in this output.
site_php_digits() {
	for f in public/.htaccess .htaccess; do
		[ -f "$f" ] || continue

		digits=$(sed -n 's/.*\(alt-php\|ea-php\|lsphp\)\([0-9][0-9]\).*/\2/p' "$f" 2>/dev/null | head -n 1)
		[ -n "$digits" ] || continue

		printf '%s' "$digits"
		return
	done
}

php_id=$(php_version_id "$php_bin")

if [ -z "$php_id" ] || [ "$php_id" -lt "$php_min_id" ]; then
	default_php="$php_bin"
	default_version=$(php_version "$default_php")
	[ -n "$default_version" ] || default_version="unavailable"

	if [ -n "${PHP_BIN:-}" ]; then
		echo "PHP_BIN ($php_bin) is PHP $default_version; this project needs 8.2 or newer." >&2
		exit 1
	fi

	php_found=0
	preferred=$(site_php_digits)

	# A handler line can also be a leftover of an older setup, so this is said
	# rather than acted on — but said, because the cabinet cannot run there.
	if [ -n "$preferred" ] && [ "$preferred" -lt 82 ]; then
		echo "Warning: .htaccess serves this site with PHP $(echo "$preferred" | sed 's/\(.\)\(.\)/\1.\2/')," >&2
		echo "below the 8.2 this project needs. Raise it in the hosting panel." >&2
		preferred=""
	fi

	# The site's own version first. Failing that, the oldest supported one: what
	# composer resolves for 8.2 also runs on whatever newer binary the site is
	# served with, while the reverse is how a working deploy turns into a white
	# page.
	for v in $preferred 82 83 84 85; do
		dotted=$(echo "$v" | sed 's/\(.\)\(.\)/\1.\2/')

		for candidate in \
			"php$dotted" \
			"php$v" \
			"/usr/local/bin/php$dotted" \
			"/opt/php$v/bin/php" \
			"/opt/alt/php$v/usr/bin/php" \
			"/opt/cpanel/ea-php$v/root/usr/bin/php"
		do
			found=$(command -v "$candidate" 2>/dev/null) || continue
			[ -n "$found" ] || continue

			found_id=$(php_version_id "$found")
			[ -n "$found_id" ] || continue
			[ "$found_id" -ge "$php_min_id" ] || continue

			php_bin="$found"
			php_found=1
			break
		done

		[ "$php_found" -eq 1 ] && break
	done

	if [ "$php_found" -eq 0 ]; then
		echo "php in PATH is PHP $default_version, and no 8.2+ binary was found in the" >&2
		echo "usual places. This project needs 8.2 or newer." >&2
		echo "" >&2
		echo "Find the one the site runs on and name it:" >&2
		echo "    ls /opt/alt/php8*/usr/bin/php /opt/php8*/bin/php /usr/bin/php8* 2>/dev/null" >&2
		echo "    PHP_BIN=/path/to/php8.3 ./updcab" >&2
		exit 1
	fi

	# Loud on purpose: every step below, composer included, then runs on another
	# binary than the one typing `php` gives.
	chosen_note=""
	if [ -n "$preferred" ] && [ "$v" = "$preferred" ]; then
		chosen_note=", the version this site is served with"
	fi

	echo "php in PATH is PHP $default_version; using $php_bin (PHP $(php_version "$php_bin")$chosen_note)."
	echo "Pass PHP_BIN=... to choose another one."
fi

# A workstation has composer in PATH; a shared host usually does not, and the
# whole update dies on its first step for a tool the operator can run by hand.
# Hence the four sources below, in order of how explicit they are.
composer_launch=""

# Composer ships as a phar or as a PHP script with a shebang, and that shebang
# picks the default interpreter — the one already ruled out above. So it is run
# under the chosen PHP; only a non-PHP wrapper is left to run on its own.
launch_for() {
	case "$1" in
		*.phar)
			printf '%s %s' "$php_bin" "$1"
			return
			;;
	esac

	if head -n 1 "$1" 2>/dev/null | grep -q '^#!.*php'; then
		printf '%s %s' "$php_bin" "$1"
		return
	fi

	printf '%s' "$1"
}

if [ -n "${COMPOSER_BIN:-}" ]; then
	composer_launch=$(launch_for "$COMPOSER_BIN")
fi

if [ -z "$composer_launch" ]; then
	for candidate in composer composer2; do
		found=$(command -v "$candidate" 2>/dev/null) || continue
		[ -n "$found" ] || continue

		composer_launch=$(launch_for "$found")
		break
	done
fi

if [ -z "$composer_launch" ]; then
	for candidate in \
		./composer.phar \
		"$HOME/composer.phar" \
		"$HOME/bin/composer" \
		"$HOME/bin/composer.phar" \
		/usr/local/bin/composer \
		/usr/local/bin/composer.phar \
		/opt/cpanel/composer/bin/composer
	do
		[ -f "$candidate" ] || continue

		case "$candidate" in
			*.phar) ;;
			*) [ -x "$candidate" ] || continue ;;
		esac

		composer_launch=$(launch_for "$candidate")
		break
	done
fi

# Last resort: ask the login shell. A host that adds composer to PATH in
# ~/.bashrc, or declares it there as an alias over a phar, gives it to an
# interactive session only — and this script is not one, which is why composer
# runs by hand and the update still cannot find it.
if [ -z "$composer_launch" ] && command -v bash >/dev/null 2>&1; then
	# Startup files may print banners; only the resolution is on the last line.
	resolved=$(bash -lic 'command -v composer' 2>/dev/null | tr -d '\r' | tail -n 1)

	case "$resolved" in
		alias*)
			# alias composer='php /path/composer.phar' — the quoted part is the command.
			composer_launch=$(printf '%s' "$resolved" | sed "s/^[^=]*=//; s/^'//; s/'\$//")

			# The alias names the default interpreter, which may be the old one.
			case "$composer_launch" in
				"php "*) composer_launch="$php_bin ${composer_launch#php }" ;;
			esac
			;;
		/*)
			composer_launch=$(launch_for "$resolved")
			;;
	esac
fi

if [ -z "$composer_launch" ]; then
	echo "composer was not found: not in PATH, not in the usual places on a" >&2
	echo "shared host, and the login shell does not resolve it either." >&2
	echo "" >&2
	echo "If it does run by hand, see what it actually is and pass that here:" >&2
	echo "    type composer" >&2
	echo "    COMPOSER_BIN=/path/to/composer ./updcab" >&2
	echo "" >&2
	echo "If the host has none, install it next to the project once:" >&2
	echo "    curl -sS https://getcomposer.org/installer | $php_bin" >&2
	exit 1
fi

composer_cmd() {
	eval "$composer_launch \"\$@\""
}

# Production serves from cached config/routes/views, and the update clears
# them; leaving the site uncached afterwards is a silent performance
# regression, so there the caches are rebuilt as a step of the update.
app_env="${APP_ENV:-}"
if [ -z "$app_env" ] && [ -f .env ]; then
	app_env=$(sed -n 's/^[[:space:]]*APP_ENV[[:space:]]*=[[:space:]]*//p' .env | head -n 1 | tr -d "\"' \r")
fi

recache=0
if [ "$app_env" = "production" ]; then
	recache=1
fi

# A package linked into vendor/ (symlink or junction) is a developer's working
# copy of its repository: composer would swap the link for a downloaded copy,
# and edits to the package would silently stop reaching this site.
linked=""
update_targets=""
for dir in vendor/posio/*/; do
	dir=${dir%/}
	[ -d "$dir" ] || continue

	if [ -L "$dir" ]; then
		linked="$linked posio/${dir##*/}"
	else
		update_targets="$update_targets posio/${dir##*/}"
	fi
done

# Nothing linked: the wildcard also installs a module required since the last run.
if [ -z "$linked" ]; then
	update_targets=" posio/*"
fi

# From here on posio/* is an argument for composer, not a path to expand.
set -f

steps=6
[ "$recache" -eq 1 ] && steps=$((steps + 1))
[ "$skip_build" -eq 1 ] && steps=$((steps - 1))
[ -z "$update_targets" ] && steps=$((steps - 1))
step=0

fail() {
	echo ""
	echo "Update stopped: the step above failed. Fix it and run ./updcab again." >&2
	exit 1
}

announce() {
	step=$((step + 1))
	echo ""
	echo "== $step/$steps $*"
}

if [ -n "$linked" ]; then
	echo ""
	echo "Not updated, linked to a working copy:$linked"
fi

if [ -z "$update_targets" ]; then
	echo ""
	echo "== skipped: composer update (every posio/* package is linked)"
else
	announce "composer update$update_targets"
	composer_cmd update $update_targets --no-interaction || fail
fi

# No-op when the composer post-update hook already ran it. Also refreshes the
# integration docs in docs/cabinet-kit/ that assistants read.
announce "php artisan cabinet-kit:sync-config"
"$php_bin" artisan cabinet-kit:sync-config || fail

# --force because a production run has no tty to answer the confirmation
# prompt with; harmless in any other environment.
announce "php artisan migrate"
"$php_bin" artisan migrate --force || fail

announce "php artisan optimize:clear"
"$php_bin" artisan optimize:clear || fail

if [ "$skip_build" -eq 1 ]; then
	echo ""
	echo "== skipped: npm install && npm run build (--no-build)"
elif command -v npm >/dev/null 2>&1; then
	announce "npm install && npm run $build_script"
	npm install || fail
	npm run "$build_script" || fail
else
	echo "npm was not found. Install Node.js, or run with --no-build when the" >&2
	echo "assets of this deploy are built elsewhere." >&2
	fail
fi

if [ "$recache" -eq 1 ]; then
	announce "php artisan optimize"
	"$php_bin" artisan optimize || fail
fi

announce "php artisan cabinet-kit:doctor"
"$php_bin" artisan cabinet-kit:doctor || fail

echo ""
echo "CabinetKit updated."
