// CabinetKit style overrides — YOUR file, in YOUR project. Safe to edit.
//
// This is imported *after* the package's own stylesheet (see the cabinet Vite
// entry, resources/_admin/js/cabinet.ts), so anything you write here wins over
// the kit's defaults through normal CSS cascade — no need to touch, fork, or
// copy anything under vendor/posio/cabinet-kit. `composer update` never
// overwrites this file.
//
// Two ways to change how the kit looks:
//
// 1. Redefine one of the original cabinet CSS variables. The package ships
//    the original shared/admin styles from posio.cabinet, so use the same
//    variables/classes you would use there. Start with
//    vendor/posio/cabinet-kit/resources/scss/colors_shared.scss,
//    vendor/posio/cabinet-kit/resources/_admin/scss/colors_admin.scss and
//    vendor/posio/cabinet-kit/resources/_admin/scss/admin.scss.
//
//      :root, html.light {
//          --primary-button-background: #16a34a;
//          --sidemenu-bg: #ffffff;
//      }
//      html.dark {
//          --primary-button-background: #22c55e;
//      }
//      :root {
//          --gm-expanded-width: 280px;  // wider pinned side menu
//      }
//
// 2. Restyle a specific element by re-declaring its class. Same specificity,
//    but loaded later, so it wins:
//
//      .card {
//          border-radius: 1rem;
//          box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
//      }
//      .button.primary-button {
//          text-transform: uppercase;
//          letter-spacing: .02em;
//      }
//
// Add your own rules below.
