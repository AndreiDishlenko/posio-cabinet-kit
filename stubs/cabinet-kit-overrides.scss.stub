// CabinetKit style overrides — YOUR file, in YOUR project. Safe to edit.
//
// This is imported *after* the package's own stylesheet (see the cabinet Vite
// entry, resources/_admin/js/admin.js), so anything you write here wins over
// the kit's defaults through normal CSS cascade — no need to touch, fork, or
// copy anything under vendor/posio/cabinet-kit. `composer update` never
// overwrites this file.
//
// Two ways to change how the kit looks:
//
// 1. Redefine a design token. Every color/size the kit paints with is a
//    --ck-* custom property, and because custom properties pierce Vue's
//    scoped styles, one override here reskins the whole kit — SideMenu,
//    header, tables and all. See the full list in
//    vendor/posio/cabinet-kit/resources/scss/colors_cabinet-kit.scss and the
//    layout tokens in cabinet-kit.scss.
//
//      :root, html.light {
//          --ck-brand-bg: #16a34a;      // primary buttons, active menu item
//          --ck-sidemenu-bg: #ffffff;
//      }
//      html.dark {
//          --ck-brand-bg: #22c55e;
//      }
//      :root {
//          --ck-expanded-width: 280px;  // wider pinned side menu
//      }
//
// 2. Restyle a specific element by re-declaring its class. Same specificity,
//    but loaded later, so it wins:
//
//      .ck-card {
//          border-radius: 1rem;
//          box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
//      }
//      .button.primary-button {
//          text-transform: uppercase;
//          letter-spacing: .02em;
//      }
//
// Add your own rules below.
