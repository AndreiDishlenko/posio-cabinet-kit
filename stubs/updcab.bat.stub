@echo off
rem Full CabinetKit update procedure (README "Update"), in the order the steps
rem depend on each other. Stops at the first failing step so a broken update is
rem not hidden by the steps after it.
rem
rem Assets are not built here: the project builds them its own way afterwards
rem (build.bat when it has one, otherwise npm run build).
rem
rem     updcab.bat --full   also update the packages' composer dependencies
rem
rem managed-by: posio/cabinet-kit
rem Refreshed from the package on every update. To keep your own version of this
rem file, delete the line above - then updates leave it alone.
setlocal EnableDelayedExpansion
cd /d "%~dp0"

rem Tells the package this file is running and must not be rewritten in place.
set "CABINET_KIT_UPDCAB=1"

set "INSTALL_DEPS=0"

:parse_args
if "%~1"=="" goto :args_done
rem Build options of earlier versions: accepted so that habits and old notes do
rem not stop the update, but the build is a separate step now.
set "IS_BUILD_OPTION=0"
if /i "%~1"=="--ssr" set "IS_BUILD_OPTION=1"
if /i "%~1"=="--no-build" set "IS_BUILD_OPTION=1"
if "%IS_BUILD_OPTION%"=="1" (
	echo %~1: the build is no longer part of updcab.bat - build the assets afterwards.
	shift
	goto :parse_args
)
rem Earlier the lock-only update was a separate launcher; now every run does it
rem for linked packages, so the option only has to be accepted.
set "IS_LOCAL=0"
if /i "%~1"=="--local" set "IS_LOCAL=1"
if /i "%~1"=="-local" set "IS_LOCAL=1"
if "%IS_LOCAL%"=="1" (
	shift
	goto :parse_args
)
rem Dependencies rarely change with a package update, and updating them is
rem the slowest part of the run - so only on request.
set "IS_FULL=0"
if /i "%~1"=="--full" set "IS_FULL=1"
if /i "%~1"=="-full" set "IS_FULL=1"
if "%IS_FULL%"=="1" (
	set "INSTALL_DEPS=1"
	shift
	goto :parse_args
)
echo unknown option: %~1
exit /b 1
:args_done

set "COMPOSER_FLAGS="
set "COMPOSER_NOTE= (dependencies kept, --full to update them)"
if "%INSTALL_DEPS%"=="1" set "COMPOSER_FLAGS= --with-all-dependencies"
if "%INSTALL_DEPS%"=="1" set "COMPOSER_NOTE="

rem A package linked into vendor (junction or symlink) is a developer's working
rem copy of its repository: composer would swap the link for a downloaded copy,
rem and edits to the package would silently stop reaching this site.
set "LINKED="
set "LINKED_NAMES="
for /d %%D in (vendor\posio\*) do (
	dir /AL /B vendor\posio 2>nul | findstr /X /I /C:"%%~nxD" >nul
	if not errorlevel 1 (
		set "LINKED=!LINKED! posio/%%~nxD"
		set "LINKED_NAMES=!LINKED_NAMES! %%~nxD"
		for /f "tokens=2 delims=[]" %%T in ('dir /AL vendor\posio 2^>nul ^| findstr /L /I /C:" %%~nxD ["') do set "LINK_TARGET_%%~nxD=%%T"
	)
)

rem A module required since the last run has no folder in vendor yet; the
rem wildcard below installs it.
set "MISSING="
for /f "delims=" %%P in ('php -r "foreach (array_keys(json_decode(file_get_contents('composer.json'), true)['require'] ?? []) as $p) if (strncmp($p, 'posio/', 6) === 0 && is_dir('vendor/' . $p) === false) echo ' ', $p;"') do set "MISSING=%%P"
if defined MISSING echo Not installed yet, required in composer.json:%MISSING%

rem Linked packages are updated too, so composer.lock records the new release
rem that servers install. Updating the lock alone is not enough: the installed
rem list would keep the old version, and the next composer install or update
rem would "repair" the difference by replacing the link with a download. So the
rem links are lifted for the run, composer installs the release where they were,
rem and the links are put back right after it, whatever composer ends with.
if not defined LINKED goto :run_composer
for %%N in (%LINKED_NAMES%) do if not defined LINK_TARGET_%%N (
	echo Could not read where vendor\posio\%%N links to.
	goto :failed
)
echo Linked to a working copy, composer.lock updated and the link kept:%LINKED%
set "DETACHED=1"
for %%N in (%LINKED_NAMES%) do rmdir "vendor\posio\%%N" 2>nul
for %%N in (%LINKED_NAMES%) do if exist "vendor\posio\%%N\" (
	echo Could not lift the link vendor\posio\%%N.
	call :restore_links
	goto :failed
)

:run_composer
echo == 1/5 composer update posio/*%COMPOSER_FLAGS%%COMPOSER_NOTE%
rem Cleared before the call: run from a .cmd, set resets the exit code it follows.
set "COMPOSER_FAILED="
call composer update posio/*%COMPOSER_FLAGS%
if errorlevel 1 set "COMPOSER_FAILED=1"
if defined DETACHED call :restore_links
if errorlevel 1 goto :failed
if defined COMPOSER_FAILED goto :failed

rem Also re-applies the wiring from the working copy: the composer hook above
rem ran it on the downloaded release while the links were lifted. Also refreshes
rem the integration docs in docs/cabinet-kit/ that assistants read.
echo == 2/5 php artisan cabinet-kit:sync-config
call php artisan cabinet-kit:sync-config
if errorlevel 1 goto :failed

echo == 3/5 php artisan migrate
call php artisan migrate
if errorlevel 1 goto :failed

echo == 4/5 php artisan optimize:clear
call php artisan optimize:clear
if errorlevel 1 goto :failed

echo == 5/5 php artisan cabinet-kit:doctor
call php artisan cabinet-kit:doctor
if errorlevel 1 goto :failed

echo.
if exist build.bat (
	echo CabinetKit updated. Build the assets next: build.bat
) else (
	echo CabinetKit updated. Build the assets next: npm run build
)
if exist updcab.bat.new echo updcab.bat refreshed from the package.
rem The new version the package left next to this file replaces it only here,
rem on the last line: cmd reads the rest of a running file from the new one.
move /y updcab.bat.new updcab.bat >nul 2>nul & exit /b 0

:failed
echo.
echo Update stopped: the step above failed. Fix it and run updcab.bat again.
move /y updcab.bat.new updcab.bat >nul 2>nul & exit /b 1

rem A link that survived the run is still the working copy - left as it is.
rem Anything else in its place is the downloaded release, removed for the link.
:restore_links
for %%N in (%LINKED_NAMES%) do (
	dir /AL /B vendor\posio 2>nul | findstr /X /I /C:"%%N" >nul
	if errorlevel 1 (
		if exist "vendor\posio\%%N\" rmdir /s /q "vendor\posio\%%N"
		mklink /J "vendor\posio\%%N" "!LINK_TARGET_%%N!" >nul
		if errorlevel 1 (
			echo Could not relink vendor\posio\%%N to !LINK_TARGET_%%N!
			exit /b 1
		)
	)
)
exit /b 0
