#!/bin/bash
#
# managed-by: posio/cabinet-kit
#
# ВНИМАНИЕ: файл принадлежит пакету posio/cabinet-kit и перезаписывается при каждом
# обновлении кабинета (./updcab → php artisan cabinet-kit:sync-config). Правка здесь
# пропадёт на ближайшем обновлении. Любые изменения вносятся только в пакет —
# stubs/cc.stub — и оттуда централизованно доходят до всех проектов.
#
# Сброс кэшей Laravel (серверный аналог cc.bat).
#   ./cc
#   PHP_BIN=/path/to/php8.3 ./cc   — интерпретатор, если автоподбор не подходит
#   NO_COLOR=1 ./cc                — вывод без цвета
#
# Фронт здесь не собирается — для него ./build.

main() {
	cd "$(dirname "$0")" || return 1

	setup_ui '1;34' 'Кэши'

	resolve_php || return 1

	stage "Laravel"

	# Каждая команда сборки кэша заодно проверяет, что он вообще собирается:
	# ошибка в конфиге или маршрутах всплывает здесь, а не на живом запросе.
	local failed=0
	run_step "config:cache"   "$PHP" artisan config:cache   || failed=1
	run_step "config:clear"   "$PHP" artisan config:clear   || failed=1
	run_step "route:cache"    "$PHP" artisan route:cache    || failed=1
	run_step "cache:clear"    "$PHP" artisan cache:clear    || failed=1
	run_step "view:cache"     "$PHP" artisan view:cache     || failed=1
	run_step "optimize:clear" "$PHP" artisan optimize:clear || failed=1

	run_step "permission:cache-reset" "$PHP" artisan permission:cache-reset || failed=1

	# Кэш маршрутов из версий Laravel до 8 новая версия не читает и не удаляет сама.
	rm -f bootstrap/cache/routes-v7.php

	if [ "$failed" -ne 0 ]; then
		failure "Кэши сброшены с ошибками"
		return 1
	fi

	success "Кэши сброшены"
}

# CLI-php хостинга по умолчанию бывает старее того, на котором работает сайт,
# а приложению нужен >= 8.2. Сначала версия сайта из панели (строка обработчика в
# .htaccess), затем самый старый 8.2+: зависимости, собранные под более новый php,
# сайт на старом не запустит.
resolve_php() {
	PHP="${PHP_BIN:-php}"
	php_is_supported "$PHP" && return 0

	if [ -n "${PHP_BIN:-}" ]; then
		fail_line "PHP_BIN ($PHP_BIN) — не PHP 8.2+."
		return 1
	fi

	local v candidate
	for v in $(site_php_digits) 82 83 84 85; do
		for candidate in "/opt/alt/php$v/usr/bin/php" "/opt/cpanel/ea-php$v/root/usr/bin/php" "php${v:0:1}.${v:1}" "php$v"; do
			command -v "$candidate" >/dev/null 2>&1 || continue
			php_is_supported "$candidate" || continue

			PHP="$candidate"
			warn_line "php из PATH не подходит — используется $PHP"
			return 0
		done
	done

	fail_line "Не найден PHP 8.2+. Указать явно: PHP_BIN=/path/to/php ./cc"
	return 1
}

php_is_supported() {
	[ "$("$1" -r 'echo PHP_VERSION_ID >= 80200 ? 1 : 0;' 2>/dev/null)" = "1" ]
}

site_php_digits() {
	local f
	for f in public/.htaccess .htaccess; do
		[ -f "$f" ] && sed -n 's/.*\(alt-php\|ea-php\|lsphp\)\([0-9][0-9]\).*/\2/p' "$f" 2>/dev/null | head -n 1
	done | head -n 1
}

# ─── Оформление ──────────────────────────────────────────────────────────────
# Одно на все скрипты пакета (deploy, build, cc, release.bat): этап — «■ Скрипт · этап»
# своим цветом у каждого скрипта, строки результата — OK / WARN / FAIL, итог — ✓ / ✗.

# Цвет — только в терминале: в логе управляющие коды были бы мусором.
setup_ui() {
	UI_NAME="$2"
	C_STAGE="" C_OK="" C_WARN="" C_FAIL="" C_DIM="" C_RESET=""
	UI_TTY=""
	[ -t 1 ] && UI_TTY=1
	[ -n "$UI_TTY" ] && [ -z "${NO_COLOR:-}" ] || return 0

	C_STAGE=$'\033['"$1"'m' C_OK=$'\033[1;32m' C_WARN=$'\033[1;33m' C_FAIL=$'\033[1;31m' C_DIM=$'\033[90m' C_RESET=$'\033[0m'
}

stage() {
	echo ""
	echo "${C_STAGE}■ ${UI_NAME} · $*${C_RESET}"
}

ok_line()   { echo "${C_OK}OK  ${C_RESET} $*"; }
warn_line() { echo "${C_WARN}WARN${C_RESET} $*"; }
fail_line() { echo "${C_FAIL}FAIL${C_RESET} $*"; }

success() {
	echo ""
	echo "${C_OK}✓ $*${C_RESET}"
}

failure() {
	echo ""
	echo "${C_FAIL}✗ $*${C_RESET}"
}

# Шаг одной строкой: пока идёт — подпись, после — OK/FAIL со временем. Вывод команды
# копится и показывается, только если шаг упал: ради него провал и читают.
run_step() {
	local label="$1" started=$SECONDS output status
	shift

	[ -n "$UI_TTY" ] && printf '%s…%s    %s' "$C_DIM" "$C_RESET" "$label"
	output="$("$@" 2>&1)"
	status=$?
	[ -n "$UI_TTY" ] && printf '\r\033[2K'

	if [ "$status" -eq 0 ]; then
		ok_line "$label ${C_DIM}$((SECONDS - started))s${C_RESET}"
	else
		fail_line "$label ${C_DIM}$((SECONDS - started))s${C_RESET}"
		[ -n "$output" ] && echo "$output" | sed 's/^/      /'
	fi

	return "$status"
}

main "$@"
exit $?
