#!/usr/bin/env bash
# Быстрый набор проверок перед релизом: release.bat запускает его до коммита,
# чтобы сломанное состояние не получило версию и не ушло в удалённый репозиторий.
#
# Базовая версия от CabinetKit: дальше файл принадлежит проекту. Шаг с тестами
# пакета убирать не нужно — обновление пакета вернёт его обратно.

set -u

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

step() {
	echo ""
	echo "[checks] $1"
}

fail() {
	echo ""
	echo "[checks] ПРОВАЛЕНО: $1"
	exit 1
}

step "Вход и регистрация CabinetKit"
php artisan cabinet-kit:test || fail "тесты CabinetKit"

step "PHP-тесты проекта"
php artisan test || fail "PHP-тесты"

# Сборка — та же, что на сервере: при SSR собирается и серверный бандл, который ловит
# обращения к браузерным объектам при импорте, пропущенные клиентской сборкой.
step "Сборка фронта"
bash build --env=local || fail "сборка"

echo ""
echo "[checks] Все проверки пройдены."
exit 0
