# Настройки проекта для скриптов CabinetKit: ./deploy, ./build (build.bat), ./cc, release.bat.
#
# Сами скрипты общие для всех проектов: они принадлежат пакету posio/cabinet-kit и
# перезаписываются при каждом обновлении кабинета. Всё, чем этот проект отличается от
# остальных, задаётся только здесь. Этот файл принадлежит проекту: пакет кладёт его
# один раз и больше не трогает.
#
# Формат — строки KEY="value": файл читают и bash, и node. Пустое значение — поведение
# по умолчанию. Настройки конкретного сервера (адрес, кэш, очередь) — в .env, не здесь.

# ─── Сборка (./build) ────────────────────────────────────────────────────────

# Своя команда сборки бандлов вместо vite build (+ vite build --ssr). Получает флаги
# --no-ssr и --verbose, если они переданы ./build, и сама оформляет свой вывод.
BUILD_COMMAND=""

# Проверки после каждой сборки и только на проде. Идут и после неудачной сборки:
# показывают, какая часть сервиса лежит.
BUILD_CHECKS=""
BUILD_PRODUCTION_CHECKS=""

# Куча node на сервере, МБ — на хостинге с лимитом памяти аккаунта, который убивает
# сборку. Локально не применяется. Разово перекрывается BUILD_MEM=... ./build
BUILD_HEAP_MB=""

# Имена SSR-процессов pm2 по окружениям. На проде по умолчанию берётся из npm-скрипта
# проекта (pm2 stop <имя>). У препрода имя задаётся только явно: чужой процесс прода
# сборка препрода трогать не должна. SSR_PROCESS в .env сервера перекрывает оба.
SSR_PROCESS_PRODUCTION=""
SSR_PROCESS_PREPROD=""

# ─── Деплой (./deploy) ───────────────────────────────────────────────────────

# Команда сразу после обновления кода, до миграций и кэша конфига (например, запись
# версии приложения из темы коммита).
DEPLOY_AFTER_CODE=""

# Кэши Laravel после деплоя прода: optimize — сбросить и собрать заново (по умолчанию),
# clear — только сбросить, если код проекта не переносит кэш конфига (env() вне конфигов).
DEPLOY_LARAVEL_CACHES=""

# Препрод: отслеживаемые git файлы, которые пересоздаёт сборка. Без них обновление
# препрода останавливалось бы на «изменённых файлах сервера».
DEPLOY_BUILD_OUTPUTS=""

# Препрод: пути сверх стандартных (resources, конфиги сборщика, package.json, scripts...),
# изменение которых требует пересобрать фронт.
DEPLOY_FRONTEND_SOURCES_EXTRA=""
